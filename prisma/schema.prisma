generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Identity & access ────────────────────────────────────────────────

enum Role {
  ADMIN
  VC
  REGISTRAR
  COE
  EXAM_STAFF
  ACADEMIC_STAFF
  HOD
  FACULTY
  EVALUATOR
  IQAC
  LIBRARIAN
  WARDEN
  ACCOUNTS
  STUDENT
  PARENT
  APPLICANT
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  designation  String?
  department   String?
  isActive     Boolean  @default(true)
  mfaEnabled   Boolean  @default(false)
  studentId    String?  @unique
  student      Student? @relation("StudentUser", fields: [studentId], references: [id])
  wardId       String?
  ward         Student? @relation("ParentWard", fields: [wardId], references: [id])
  createdAt    DateTime @default(now())

  evaluations      Evaluation[]
  papersSet        ExamPaper[]   @relation("PaperSetter")
  auditLogs        AuditLog[]
  coursesTaught    Course[]      @relation("CourseFaculty")
  invigilations    Invigilation[]
}

// ─── Academic structure ───────────────────────────────────────────────

enum ProgrammeLevel {
  UG
  PG
  DOCTORAL
  DIPLOMA
}

model Programme {
  id                String              @id @default(cuid())
  code              String              @unique
  name              String
  level             ProgrammeLevel
  durationSemesters Int
  degreeTitle       String?
  curricula         CurriculumVersion[]
  batches           Batch[]
  ruleSets          RuleSet[]
  admissionCycles   AdmissionCycle[]
}

model CurriculumVersion {
  id               String    @id @default(cuid())
  programmeId      String
  programme        Programme @relation(fields: [programmeId], references: [id])
  code             String    @unique
  name             String
  effectiveFrom    Int
  effectiveTo      Int?
  creditsPerCourse Int
  totalCredits     Int?
  notes            String?
  status           String    @default("APPROVED") // DRAFT | APPROVED
  approvalRef      String?
  approvedAt       DateTime?
  basedOnCode      String?
  courses          Course[]
  batches          Batch[]
}

// ─── Helpdesk ─────────────────────────────────────────────────────────

/// Support request; response and resolution targets come from its priority (SLA).
model Ticket {
  id              String          @id @default(cuid())
  number          Int             @unique @default(autoincrement())
  subject         String
  category        String          // ACCESS | EXAMS | RESULTS | ATTENDANCE | FEES | DOCUMENTS | ADMISSIONS | OTHER
  priority        String          // LOW | MEDIUM | HIGH | CRITICAL
  status          String          @default("OPEN") // OPEN | IN_PROGRESS | WAITING_USER | RESOLVED | CLOSED
  page            String?
  raisedById      String
  assignedToId    String?
  responseDueAt   DateTime
  resolveDueAt    DateTime
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  rating          Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  messages        TicketMessage[]

  @@index([status, assignedToId])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String?
  body      String
  internal  Boolean  @default(false)
  kind      String   @default("COMMENT") // COMMENT | EVENT
  createdAt DateTime @default(now())
}

// ─── Backup ───────────────────────────────────────────────────────────

/// One database backup file (compressed logical dump of every table) and what was done with it.
model BackupRun {
  id          String    @id @default(cuid())
  kind        String    // SCHEDULED | MANUAL | PRE_RESTORE
  status      String    @default("RUNNING") // RUNNING | OK | FAILED | PRUNED
  fileName    String?
  sizeBytes   Int?
  sha256      String?
  tables      Int?
  rows        Int?
  durationMs  Int?
  error       String?
  note        String?
  createdById String?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  verifiedAt  DateTime?
  restoredAt  DateTime?
}

// ─── Integrations & data migration ────────────────────────────────────

/// Credential for a partner system calling the REST API; only a SHA-256 hash of the secret is stored.
model ApiKey {
  id          String       @id @default(cuid())
  name        String
  prefix      String       @unique
  keyHash     String       @unique
  scopes      String[]
  createdById String
  createdAt   DateTime     @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  calls       ApiCallLog[]
}

model ApiCallLog {
  id     Int      @id @default(autoincrement())
  keyId  String?
  key    ApiKey?  @relation(fields: [keyId], references: [id], onDelete: SetNull)
  method String
  path   String
  status Int
  ms     Int
  at     DateTime @default(now())

  @@index([keyId, at])
}

model IntegrationConnector {
  code        String   @id // DIGILOCKER | ABC | PAYMENT | SMS
  name        String
  endpoint    String
  enabled     Boolean  @default(true)
  simulateOutage Boolean @default(false)
  lastRunAt   DateTime?
  updatedAt   DateTime @updatedAt
}

/// Outbound delivery queue (e.g. issued certificates pushed to DigiLocker), retried with back-off.
model IntegrationJob {
  id            String    @id @default(cuid())
  connector     String
  documentId    String?
  studentId     String?
  label         String
  status        String    @default("PENDING") // PENDING | DELIVERED | FAILED
  attempts      Int       @default(0)
  lastError     String?
  externalRef   String?
  nextAttemptAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  deliveredAt   DateTime?

  @@index([connector, status])
}

/// One uploaded migration file: rows are staged and reconciled before anything is written.
model ImportBatch {
  id           String      @id @default(cuid())
  kind         String      // STUDENTS | RESULTS
  fileName     String
  status       String      @default("STAGED") // STAGED | COMMITTED | ROLLED_BACK
  rowCount     Int
  validCount   Int
  warningCount Int
  errorCount   Int
  columns      String[]
  summary      Json?
  createdById  String
  createdAt    DateTime    @default(now())
  committedAt  DateTime?
  rolledBackAt DateTime?
  rows         ImportRow[]
}

model ImportRow {
  id        String      @id @default(cuid())
  batchId   String
  batch     ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNo     Int
  data      Json
  status    String      // VALID | WARNING | ERROR
  messages  String[]
  created   Json?       // ids written on commit, used for rollback

  @@index([batchId, rowNo])
}

/// Academic calendar entry (teaching terms, examinations, holidays, deadlines, events).
model AcademicEvent {
  id           String   @id @default(cuid())
  academicYear String
  title        String
  type         String   // TEACHING | EXAM | HOLIDAY | VACATION | DEADLINE | ADMISSION | EVENT
  startDate    DateTime @db.Date
  endDate      DateTime @db.Date
  audience     String   @default("ALL") // ALL | STUDENTS | STAFF
  description  String?
  createdById  String?
  createdAt    DateTime @default(now())

  @@index([startDate, endDate])
}

model Batch {
  id                  String            @id @default(cuid())
  code                String            @unique
  name                String
  programmeId         String
  programme           Programme         @relation(fields: [programmeId], references: [id])
  curriculumVersionId String
  curriculumVersion   CurriculumVersion @relation(fields: [curriculumVersionId], references: [id])
  admissionYear       Int
  currentSemester     Int
  students            Student[]
  ruleSets            RuleSet[]
}

enum CourseCategory {
  CORE
  CLINICAL
  OPTIONAL
  HONOURS
  HSS
  SPECIALIZATION
  DISSERTATION
  MOOT
}

model EvaluationScheme {
  id          String                @id @default(cuid())
  code        String                @unique
  name        String
  description String?
  passRule    String                @default("AGGREGATE") // AGGREGATE | COMPONENT_AND_AGGREGATE
  aggregatePassPct Float            @default(50)
  components  AssessmentComponent[]
  courses     Course[]
}

model AssessmentComponent {
  id        String           @id @default(cuid())
  schemeId  String
  scheme    EvaluationScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  code      String
  name      String
  maxMarks  Float
  passMarks Float?
  group     String           @default("THEORY") // THEORY | PRACTICAL
  source    String           @default("FACULTY") // FACULTY | EXAM (on-screen evaluation) | EXTERNAL | SYSTEM
  sortOrder Int              @default(0)
  subCriteria Json?
  markEntries MarkEntry[]
  marksSheets InternalMarksSheet[]

  @@unique([schemeId, code])
}

model Course {
  id                  String            @id @default(cuid())
  curriculumVersionId String
  curriculumVersion   CurriculumVersion @relation(fields: [curriculumVersionId], references: [id])
  code                String
  title               String
  semester            Int
  credits             Int
  category            CourseCategory
  maxMarks            Int               @default(100)
  plannedSessions     Int               @default(52)
  schemeId            String
  scheme              EvaluationScheme  @relation(fields: [schemeId], references: [id])
  facultyId           String?
  faculty             User?             @relation("CourseFaculty", fields: [facultyId], references: [id])
  enrolments          Enrolment[]
  examPapers          ExamPaper[]
  marksSheets         InternalMarksSheet[]
  classSessions       ClassSession[]

  @@unique([curriculumVersionId, code])
}

// ─── Students ─────────────────────────────────────────────────────────

model Student {
  id           String   @id @default(cuid())
  uid          String   @unique
  rollNo       String   @unique
  name         String
  gender       String
  dob          DateTime?
  email        String
  phone        String?
  category     String   @default("GEN")
  abcId        String?
  parentName   String?
  parentPhone  String?
  parentEmail  String?
  photoUrl     String?
  status       String   @default("ACTIVE")
  batchId      String
  batch        Batch    @relation(fields: [batchId], references: [id])
  createdAt    DateTime @default(now())

  user          User?              @relation("StudentUser")
  parents       User[]             @relation("ParentWard")
  enrolments    Enrolment[]
  registrations ExamRegistration[]
  seats         SeatAllocation[]
  scripts       AnswerScript[]
  courseResults CourseResult[]
  semResults    SemesterResult[]
  documents     Document[]
  relaxations   RelaxationRequest[]
  revaluations  RevaluationRequest[]
  leaves        LeaveRequest[]
  attendanceAlerts AttendanceAlert[]
  feedbackSubmissions FeedbackSubmission[]
  degreeApplications  DegreeApplication[]
  clearances          Clearance[]
  exitRequest         ExitRequest?
  alumniProfile       AlumniProfile?
  application         Application?
  profileRequests     ProfileChangeRequest[]
}

enum EnrolmentType {
  REGULAR
  REPEAT
  IMPROVEMENT
  REREGISTER
}

model Enrolment {
  id           String        @id @default(cuid())
  studentId    String
  student      Student       @relation(fields: [studentId], references: [id])
  courseId     String
  course       Course        @relation(fields: [courseId], references: [id])
  academicYear String
  semester     Int
  attempt      Int           @default(1)
  type         EnrolmentType @default(REGULAR)
  status       String        @default("ACTIVE")

  attendance    AttendanceSummary?
  markEntries   MarkEntry[]
  eligibilities Eligibility[]
  courseResults CourseResult[]
  relaxations   RelaxationRequest[]
  attendanceRecords AttendanceRecord[]
  attendanceAlerts  AttendanceAlert[]

  @@unique([studentId, courseId, academicYear, attempt])
}

model AttendanceSummary {
  id               String    @id @default(cuid())
  enrolmentId      String    @unique
  enrolment        Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  classesHeld      Int
  classesAttended  Int
  medicalLeaveDays Int       @default(0)
  biometricCount   Int?
  updatedAt        DateTime  @updatedAt
}

// ─── Degree & convocation ─────────────────────────────────────────────

model Convocation {
  id                  String              @id @default(cuid())
  number              Int                 @unique
  title               String
  date                DateTime
  venue               String
  chiefGuest          String?
  status              String              @default("PLANNING") // PLANNING | APPLICATIONS_OPEN | LIST_FROZEN | DEGREES_ISSUED
  applicationDeadline DateTime
  feeInPerson         Int                 @default(2500)
  feeInAbsentia       Int                 @default(1500)
  medals              Json                // [{ code, name, criterion: { type: HIGHEST_CGPA | HIGHEST_TOTAL, courses? } }]
  councilResolution   String?
  frozenAt            DateTime?
  frozenById          String?
  issuedAt            DateTime?
  applications        DegreeApplication[]
}

model DegreeApplication {
  id            String      @id @default(cuid())
  convocationId String
  convocation   Convocation @relation(fields: [convocationId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id])
  mode          String      // IN_PERSON | IN_ABSENTIA
  guests        Int         @default(0)
  fee           Int
  paymentRef    String
  status        String      @default("APPLIED") // APPLIED | APPROVED | NOT_ELIGIBLE
  reason        String?
  serialNo      String?     @unique
  appliedAt     DateTime    @default(now())

  @@unique([convocationId, studentId])
}

/// A student leaving the University: graduation, withdrawal or transfer. Drives no-dues, refund and certificates.
model ExitRequest {
  id                String    @id @default(cuid())
  studentId         String    @unique
  student           Student   @relation(fields: [studentId], references: [id])
  type              String    // GRADUATION | WITHDRAWAL | TRANSFER
  reason            String?
  status            String    @default("OPEN") // OPEN | COMPLETED
  cautionDeposit    Int       @default(10000)
  deductions        Int       @default(0)
  bankAccount       String?
  ifsc              String?
  refundRef         String?
  refundedAt        DateTime?
  forwardingAddress String?
  createdAt         DateTime  @default(now())
  completedAt       DateTime?
}

/// Alumni registry: graduates of this system plus records migrated from earlier years.
model AlumniProfile {
  id               String   @id @default(cuid())
  studentId        String?  @unique
  student          Student? @relation(fields: [studentId], references: [id])
  name             String
  programme        String   // BALLB | LLM | PHD
  graduationYear   Int
  email            String
  phone            String?
  sector           String   // LITIGATION | LAW_FIRM | CORPORATE | JUDICIARY | HIGHER_STUDIES | CIVIL_SERVICES | ACADEMIA | POLICY_NGO | OTHER | SEEKING
  organisation     String?
  designation      String?
  city             String?
  qualifiedExams   String[] @default([])
  directoryConsent Boolean  @default(true)
  mentor           Boolean  @default(false)
  source           String   @default("SELF") // SELF | MIGRATED
  updatedAt        DateTime @updatedAt
}

// ─── Admissions ───────────────────────────────────────────────────────

/// One admission round for a programme: seat matrix, required documents and merit rule are configured per cycle.
model AdmissionCycle {
  id                String        @id @default(cuid())
  code              String        @unique
  name              String
  programmeId       String
  programme         Programme     @relation(fields: [programmeId], references: [id])
  academicYear      String
  status            String        @default("APPLICATIONS") // APPLICATIONS | EVALUATION | MERIT_PUBLISHED | CLOSED
  opensAt           DateTime
  closesAt          DateTime
  applicationFee    Int
  admissionFee      Int
  seatMatrix        Json          // { UR: 5, OBC: 2, SC: 1, ST: 1, EWS: 1 }
  requiredDocs      Json          // [{ code, label, when?: "RESERVED" | "PWD" }]
  meritRule         Json          // { components: [{ code, label, max, weight }], qualifying: {...}, eligibility: {...} }
  meritPublishedAt  DateTime?
  offerDeadline     DateTime?
  applications      Application[]
}

model Application {
  id                String                @id @default(cuid())
  cycleId           String
  cycle             AdmissionCycle        @relation(fields: [cycleId], references: [id])
  appNo             String                @unique
  userId            String?               @unique
  name              String
  gender            String
  dob               DateTime
  email             String
  phone             String
  category          String                // GEN | OBC | SC | ST | EWS
  pwd               Boolean               @default(false)
  domicile          String
  address           String
  parentName        String
  qualifyingDegree  String
  qualifyingUniv    String
  qualifyingYear    Int
  qualifyingPct     Float
  netQualified      Boolean               @default(false)
  researchArea      String?
  proposalTitle     String?
  status            String                @default("DRAFT") // DRAFT | SUBMITTED | RETURNED | VERIFIED | REJECTED
  remarks           String?
  feeRef            String?
  submittedAt       DateTime?
  verifiedAt        DateTime?
  marks             Json?                 // { TEST: 64, INTERVIEW: 38 }
  composite         Float?
  meritRank         Int?
  outcome           String?               // OFFERED | WAITLISTED | NOT_QUALIFIED | ADMITTED | DECLINED
  seatCategory      String?
  admissionFeeRef   String?
  decidedAt         DateTime?
  studentId         String?               @unique
  student           Student?              @relation(fields: [studentId], references: [id])
  documents         ApplicationDocument[]
}

model ApplicationDocument {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  code          String
  fileName      String
  mime          String
  size          Int
  data          Bytes?
  status        String      @default("PENDING") // PENDING | ACCEPTED | REJECTED
  remark        String?
  version       Int         @default(1)
  verifiedById  String?
  uploadedAt    DateTime    @default(now())
  verifiedAt    DateTime?

  @@unique([applicationId, code])
}

/// Student-initiated change to identity data; contact details change instantly, identity fields need approval.
model ProfileChangeRequest {
  id          String    @id @default(cuid())
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id])
  field       String
  oldValue    String?
  newValue    String
  reason      String
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED
  remark      String?
  decidedById String?
  createdAt   DateTime  @default(now())
  decidedAt   DateTime?
}

/// Departmental no-dues clearance (library, hostel, accounts, examination) required before a degree or exit.
model Clearance {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  department  String   // LIBRARY | HOSTEL | ACCOUNTS | EXAMINATION
  status      String   @default("PENDING") // PENDING | CLEARED | DUES
  amount      Int?
  note        String?
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@unique([studentId, department])
}

// ─── Student feedback (anonymous) ─────────────────────────────────────

model FeedbackForm {
  id                String               @id @default(cuid())
  title             String
  type              String               // COURSE (per course & teacher) | INSTITUTION (satisfaction survey) | EXIT (graduating students)
  academicYear      String
  description       String?
  questions         Json                 // [{ id, section, text, kind: LIKERT | TEXT, required }]
  status            String               @default("DRAFT") // DRAFT | OPEN | CLOSED
  opensAt           DateTime
  closesAt          DateTime
  minResponses      Int                  @default(5)
  releasedToFaculty Boolean              @default(false)
  createdById       String
  createdAt         DateTime             @default(now())
  submissions       FeedbackSubmission[]
  responses         FeedbackResponse[]
  actions           FeedbackAction[]
}

/// Who has given feedback (for reminders and completion rates) — never what they answered.
model FeedbackSubmission {
  id          String       @id @default(cuid())
  formId      String
  form        FeedbackForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student      @relation(fields: [studentId], references: [id])
  courseId    String       @default("")
  submittedOn DateTime     @db.Date

  @@unique([formId, studentId, courseId])
}

/// The answers, with no link to the student who gave them.
model FeedbackResponse {
  id          String       @id @default(cuid())
  formId      String
  form        FeedbackForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  courseId    String       @default("")
  facultyId   String?
  batchId     String?
  answers     Json
  submittedOn DateTime     @db.Date

  @@index([formId, courseId])
}

/// Action taken on feedback (NAAC criterion 1.4).
model FeedbackAction {
  id          String       @id @default(cuid())
  formId      String
  form        FeedbackForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  courseId    String       @default("")
  note        String
  createdById String
  createdAt   DateTime     @default(now())
}

/// One scheduled class meeting of a course; its records roll up into AttendanceSummary.
model ClassSession {
  id           String             @id @default(cuid())
  courseId     String
  course       Course             @relation(fields: [courseId], references: [id])
  academicYear String
  startsAt     DateTime
  kind         String             @default("LECTURE") // LECTURE | TUTORIAL | MOOT_PRACTICE
  topic        String?
  status       String             @default("SCHEDULED") // SCHEDULED | MARKED
  source       String?            // FACULTY | BIOMETRIC
  markedById   String?
  markedAt     DateTime?
  records      AttendanceRecord[]

  @@unique([courseId, academicYear, startsAt])
  @@index([academicYear, startsAt])
}

model AttendanceRecord {
  id          String       @id @default(cuid())
  sessionId   String
  session     ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enrolmentId String
  enrolment   Enrolment    @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  status      String       // PRESENT | ABSENT | DUTY_LEAVE | MEDICAL_LEAVE
  updatedAt   DateTime     @updatedAt

  @@unique([sessionId, enrolmentId])
  @@index([enrolmentId])
}

model LeaveRequest {
  id           String    @id @default(cuid())
  studentId    String
  student      Student   @relation(fields: [studentId], references: [id])
  type         String    // MEDICAL | DUTY
  fromDate     DateTime
  toDate       DateTime
  reason       String
  document     String?
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  sessions     Int       @default(0)
  createdAt    DateTime  @default(now())
}

model AttendanceAlert {
  id          String    @id @default(cuid())
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id])
  enrolmentId String
  enrolment   Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  level       String    // WARNING | SHORTAGE | CRITICAL | NOTICE
  pct         Float
  message     String
  channels    String    @default("SMS, e-mail (student and parent)")
  sentById    String?
  createdAt   DateTime  @default(now())
}

// ─── Configurable rules (rule engine) ─────────────────────────────────

enum RuleType {
  ATTENDANCE
  GRADING
  GRACE
  PROMOTION
  REVALUATION
  MODERATION
  SUPPLEMENTARY
}

model RuleSet {
  id           String     @id @default(cuid())
  key          String     // stable identifier across versions, e.g. ATT-BALLB
  type         RuleType
  name         String
  description  String?
  programmeId  String?
  programme    Programme? @relation(fields: [programmeId], references: [id])
  batchId      String?
  batch        Batch?     @relation(fields: [batchId], references: [id])
  version      Int        @default(1)
  isActive     Boolean    @default(true)
  params       Json
  logic        Json?
  effectiveFrom DateTime  @default(now())
  createdById  String?
  createdAt    DateTime   @default(now())
  changeNote   String?

  @@unique([key, version])
}

// ─── Examinations ─────────────────────────────────────────────────────

enum ExamType {
  REGULAR
  REPEAT
  SPECIAL
  IMPROVEMENT
  REREGISTERED
}

model Exam {
  id               String       @id @default(cuid())
  code             String       @unique
  name             String
  type             ExamType
  academicYear     String
  parity           String       // ODD | EVEN
  status           String       @default("PLANNED") // PLANNED | REGISTRATION | SCHEDULED | IN_PROGRESS | EVALUATION | RESULT | CLOSED
  startDate        DateTime
  endDate          DateTime
  registrationOpen Boolean      @default(false)
  admitCardsPublished Boolean   @default(false)
  feeAmount        Int          @default(0)
  timetablePublishedAt DateTime?
  timetableGapDays Int          @default(1)
  papers           ExamPaper[]
  invigilations    Invigilation[]
  registrations    ExamRegistration[]
  eligibilities    Eligibility[]
  resultRuns       ResultRun[]
  relaxations      RelaxationRequest[]
  revaluations     RevaluationRequest[]
  moderations      ModerationAction[]
}

model ExamPaper {
  id             String         @id @default(cuid())
  examId         String
  exam           Exam           @relation(fields: [examId], references: [id])
  courseId       String
  course         Course         @relation(fields: [courseId], references: [id])
  date           DateTime
  session        String         // FN | AN
  durationMins   Int
  maxMarks       Int
  questionScheme Json?
  setterId       String?
  setter         User?          @relation("PaperSetter", fields: [setterId], references: [id])
  evaluationMode String         @default("SINGLE") // SINGLE | DOUBLE | TRIPLE
  seats          SeatAllocation[]
  scripts        AnswerScript[]
  registrationPapers RegistrationPaper[]
  moderations    ModerationAction[]

  @@unique([examId, courseId])
}

model Eligibility {
  id            String    @id @default(cuid())
  examId        String
  exam          Exam      @relation(fields: [examId], references: [id])
  enrolmentId   String
  enrolment     Enrolment @relation(fields: [enrolmentId], references: [id])
  status        String    // ELIGIBLE | INELIGIBLE | PENDING_RELAXATION | RELAXED
  relaxable     Boolean   @default(false)
  reason        String?
  coursePct     Float
  aggregatePct  Float
  semesterPct   Float?
  ruleSetId     String?
  ruleVersion   Int?
  computedAt    DateTime  @default(now())

  @@unique([examId, enrolmentId])
}

model RelaxationRequest {
  id           String    @id @default(cuid())
  examId       String
  exam         Exam      @relation(fields: [examId], references: [id])
  studentId    String
  student      Student   @relation(fields: [studentId], references: [id])
  enrolmentId  String
  enrolment    Enrolment @relation(fields: [enrolmentId], references: [id])
  ground       String    // MEDICAL | EMERGENCY | OTHER
  remarks      String?
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  requestedById String?
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime  @default(now())
}

model ExamRegistration {
  id          String              @id @default(cuid())
  examId      String
  exam        Exam                @relation(fields: [examId], references: [id])
  studentId   String
  student     Student             @relation(fields: [studentId], references: [id])
  status      String              @default("SUBMITTED") // DRAFT | SUBMITTED | APPROVED
  feePaid     Boolean             @default(false)
  paymentRef  String?
  submittedAt DateTime            @default(now())
  papers      RegistrationPaper[]
  admitCardCode String?           @unique

  @@unique([examId, studentId])
}

model RegistrationPaper {
  id             String           @id @default(cuid())
  registrationId String
  registration   ExamRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  examPaperId    String
  examPaper      ExamPaper        @relation(fields: [examPaperId], references: [id])
  kind           String           @default("REGULAR") // REGULAR | BACKLOG | IMPROVEMENT
  supMark        SupplementaryMark?

  @@unique([registrationId, examPaperId])
}

/// Award-list mark for a backlog / improvement paper (the regular attempt's marks are never overwritten).
model SupplementaryMark {
  id                  String            @id @default(cuid())
  registrationPaperId String            @unique
  registrationPaper   RegistrationPaper @relation(fields: [registrationPaperId], references: [id], onDelete: Cascade)
  marks               Float?
  absent              Boolean           @default(false)
  status              String            @default("DRAFT") // DRAFT | SUBMITTED
  enteredById         String?
  updatedAt           DateTime          @updatedAt
}

model ModerationAction {
  id           String    @id @default(cuid())
  examId       String
  exam         Exam      @relation(fields: [examId], references: [id])
  examPaperId  String
  examPaper    ExamPaper @relation(fields: [examPaperId], references: [id])
  delta        Float
  reason       String
  status       String    @default("PROPOSED") // PROPOSED | APPROVED | REJECTED
  before       Json
  after        Json
  ruleVersion  Int
  proposedById String
  proposedAt   DateTime  @default(now())
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
}

model Room {
  id       String           @id @default(cuid())
  centre   String
  code     String           @unique
  name     String
  rows     Int
  cols     Int
  seats    SeatAllocation[]
  invigilations Invigilation[]
}

model Invigilation {
  id      String   @id @default(cuid())
  examId  String
  exam    Exam     @relation(fields: [examId], references: [id])
  date    DateTime
  session String
  roomId  String?
  room    Room?    @relation(fields: [roomId], references: [id])
  userId  String
  user    User     @relation(fields: [userId], references: [id])
  duty    String   @default("INVIGILATOR") // INVIGILATOR | FLYING_SQUAD
}

model SeatAllocation {
  id          String    @id @default(cuid())
  examPaperId String
  examPaper   ExamPaper @relation(fields: [examPaperId], references: [id])
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id])
  roomId      String
  room        Room      @relation(fields: [roomId], references: [id])
  benchNo     String
  attended    Boolean?

  @@unique([examPaperId, studentId])
}

model MalpracticeCase {
  id          String   @id @default(cuid())
  examPaperId String
  studentId   String
  description String
  evidenceUrl String?
  reportedBy  String
  status      String   @default("REPORTED")
  createdAt   DateTime @default(now())
}

// ─── Answer scripts & on-screen evaluation ────────────────────────────

model AnswerScript {
  id          String         @id @default(cuid())
  examPaperId String
  examPaper   ExamPaper      @relation(fields: [examPaperId], references: [id])
  studentId   String
  student     Student        @relation(fields: [studentId], references: [id])
  dummyNo     String         @unique
  barcode     String         @unique
  scanUrl     String?
  pageCount   Int            @default(0)
  status      String         @default("RECEIVED") // RECEIVED | SCANNED | ALLOCATED | EVALUATED | FINALISED
  finalMarks  Float?
  evaluations Evaluation[]
  custody     CustodyEvent[]

  @@unique([examPaperId, studentId])
}

model CustodyEvent {
  id        String       @id @default(cuid())
  scriptId  String
  script    AnswerScript @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  action    String       // COLLECTED | SEALED | STRONG_ROOM_IN | DISPATCHED | RECEIVED | SCANNED
  location  String
  handler   String
  at        DateTime     @default(now())
}

model Evaluation {
  id            String       @id @default(cuid())
  scriptId      String
  script        AnswerScript @relation(fields: [scriptId], references: [id])
  evaluatorId   String
  evaluator     User         @relation(fields: [evaluatorId], references: [id])
  round         Int          @default(1)
  marks         Json?
  total         Float?
  remarks       String?
  status        String       @default("ASSIGNED") // ASSIGNED | IN_PROGRESS | SUBMITTED | LOCKED
  submittedAt   DateTime?
  signatureHash String?
  createdAt     DateTime     @default(now())

  @@unique([scriptId, round])
}

// ─── Marks & results ──────────────────────────────────────────────────

model MarkEntry {
  id          String              @id @default(cuid())
  enrolmentId String
  enrolment   Enrolment           @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  componentId String
  component   AssessmentComponent @relation(fields: [componentId], references: [id])
  marks       Float?
  absent      Boolean             @default(false)
  status      String              @default("DRAFT") // DRAFT | SUBMITTED | LOCKED
  source      String              @default("FACULTY")
  detail      Json?               // sub-criteria (rubric) marks, e.g. { FACTS: 4, LAW: 3.5 }
  moderation  Float               @default(0) // added by an approved paper moderation; raw marks stay as evaluated
  enteredById String?
  updatedAt   DateTime            @updatedAt

  @@unique([enrolmentId, componentId])
}

/// One faculty marks sheet per course, internal component and academic year.
model InternalMarksSheet {
  id            String              @id @default(cuid())
  courseId      String
  course        Course              @relation(fields: [courseId], references: [id])
  componentId   String
  component     AssessmentComponent @relation(fields: [componentId], references: [id])
  academicYear  String
  status        String              @default("DRAFT") // DRAFT | SUBMITTED | VERIFIED | RETURNED
  deadline      DateTime
  submittedById String?
  submittedAt   DateTime?
  signatureHash String?
  verifiedById  String?
  verifiedAt    DateTime?
  note          String?
  updatedAt     DateTime            @updatedAt

  @@unique([courseId, componentId, academicYear])
}

model ResultRun {
  id            String           @id @default(cuid())
  examId        String
  exam          Exam             @relation(fields: [examId], references: [id])
  batchId       String?
  label         String
  status        String           @default("PROCESSED") // PROCESSED | SUBMITTED | APPROVED | PUBLISHED | WITHDRAWN
  rulesUsed     Json
  summary       Json?
  processedById String
  processedAt   DateTime         @default(now())
  submittedById String?
  submittedAt   DateTime?
  approvedById  String?
  approvedAt    DateTime?
  publishedById String?
  publishedAt   DateTime?
  courseResults CourseResult[]
  semResults    SemesterResult[]
}

model CourseResult {
  id            String    @id @default(cuid())
  runId         String
  run           ResultRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  enrolmentId   String
  enrolment     Enrolment @relation(fields: [enrolmentId], references: [id])
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id])
  courseId      String
  components    Json
  rawTotal      Float
  grace         Float     @default(0)
  total         Float
  grade         String
  gradePoint    Float
  credits       Int
  status        String    // PASS | FAIL | AB | NA | W
  flags         Json?

  @@unique([runId, enrolmentId])
}

model SemesterResult {
  id          String    @id @default(cuid())
  runId       String
  run         ResultRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id])
  semester    Int
  credits     Int
  earnedCredits Int
  sgpa        Float
  cgpa        Float
  result      String    // PASS | FAIL | WITHHELD
  division    String?
  flags       Json?

  @@unique([runId, studentId, semester])
}

// ─── Documents & verification ─────────────────────────────────────────

model Document {
  id          String   @id @default(cuid())
  type        String   // GRADE_SHEET | TRANSCRIPT | ADMIT_CARD | DEGREE
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  refId       String?
  verifyCode  String   @unique
  payload     Json
  payloadHash String
  isDuplicate Boolean  @default(false)
  revoked     Boolean  @default(false)
  issuedById  String?
  issuedAt    DateTime @default(now())
}

// ─── Post-result: revaluation & scrutiny ──────────────────────────────

model RevaluationRequest {
  id            String    @id @default(cuid())
  examId        String
  exam          Exam      @relation(fields: [examId], references: [id])
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id])
  enrolmentId   String
  scriptId      String
  courseCode    String
  type          String    // REVALUATION | SCRUTINY
  status        String    @default("PAID") // PAID | ASSIGNED | EVALUATED | DECIDED
  reason        String?
  fee           Int
  paymentRef    String
  originalMarks Float
  revisedMarks  Float?
  maxMarks      Float
  evaluationId  String?
  findings      Json?
  outcome       String?   // REVISED | UNCHANGED
  outcomeNote   String?
  ruleVersion   Int?
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())
}

// ─── Self-service reports ─────────────────────────────────────────────

model SavedReport {
  id          String   @id @default(cuid())
  name        String
  description String?
  dataset     String
  config      Json
  createdById String?
  createdAt   DateTime @default(now())
}

// ─── Audit trail (hash-chained, tamper-evident) ───────────────────────

model AuditLog {
  id        Int      @id @default(autoincrement())
  at        DateTime @default(now())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  actorRole String?
  action    String
  entity    String
  entityId  String?
  summary   String?
  before    Json?
  after     Json?
  prevHash  String
  hash      String

  @@index([entity, entityId])
  @@index([actorId])
}
